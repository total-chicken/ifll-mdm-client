# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

MDM_USERNAME=
MDM_PASSWORD=

# MDM base host and Keycloak realm (defaults match production, override only if needed)
MDM_HOST=https://mdm.genusdvvnl.in
MDM_REALM=genuspower
MDM_CLIENT_ID=mdm-ui
MDM_API_BASE=/urjaservice

# Populated automatically by `npm run login` after a successful login; do not set by hand.
MDM_ACCESS_TOKEN=
MDM_REFRESH_TOKEN=
MDM_TOKEN_EXPIRES_AT=
